{
"$schema":"sdv_snippets.schema.json",
"$basedir":".",
"$write":{
	"path":"../README.md",
	"content":{
		"$replace":{
			"content":{
				"$switch":{
					"cond":{ "$opt":{ "arg":"--target" } },
					"cases":{
						"github":{ "$read":{ "path":"README_GITHUB.template.md" } },
						"pypi":{ "$read":{ "path":"README_PYPI.template.md" } }
						}
					}
				},
			"rules": {
				"_README_LOGO_":{
					"$switch":{
						"cond":{ "$opt":{ "arg":"--target" } },
						"cases":{
							"github":{ "$read":{ "path":"README_LOGO_GITHUB.template.md" } },
							"pypi":{ "$read":{ "path":"README_LOGO_PYPI.template.md" } }
							}
						}
					},
				"_BADGES_":{
					"$replace":{
						"content": {"$read":{ "path":"README_BADGES.template.md" } },
						"rules":{
							"_COMMON_":{
								"$replace":{
									"content":{ "$read":{ "path":"README_BADGES_COMMON.template.md" } },
									"rules":{
										"_VERSION_":{ "$read":{ "path":"../VERSION" } }
										}
									}
								},
							"_TARGET_":{
								"$replace":{
									"content":{
										"$switch":{
											"cond":{ "$opt":{ "arg":"--target" } },
											"cases":{
												"github":{ "$read":{ "path":"README_BADGES_GITHUB.template.md" } },
												"pypi":{ "$read":{ "path":"README_BADGES_PYPI.template.md" } }
												}
											}
										},
									"rules":{
										"_VERSION_":{ "$read":{ "path":"../VERSION" } }
										}
									}
								}
							}
						}
					},
				"_README_COMMON_":{
					"$read":{ "path":"README_COMMON.template.md" }
					}
				}
			}
		}
	}
}
